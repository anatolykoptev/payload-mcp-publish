{
  "name": "payload-mcp-publish",
  "version": "0.0.0",
  "description": "A reviewed publish lane for @payloadcms/plugin-mcp: dry-run diff plus digest, key-scope check, owner-unpublished guard.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/anatolykoptev/payload-mcp-publish#readme",
  "bugs": {
    "url": "https://github.com/anatolykoptev/payload-mcp-publish/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anatolykoptev/payload-mcp-publish.git"
  },
  "keywords": [
    "payload",
    "payload-plugin",
    "payloadcms",
    "mcp",
    "publish",
    "drafts"
  ],
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "files": [
    "dist",
    "!dist/**/*.map",
    "NOTICE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@payloadcms/plugin-mcp": "^3.93.0",
    "payload": "^3.93.0",
    "zod": "^3.25.50"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@payloadcms/db-sqlite": "3.93.0",
    "@payloadcms/next": "3.93.0",
    "@payloadcms/plugin-mcp": "3.93.0",
    "@payloadcms/richtext-lexical": "3.93.0",
    "@payloadcms/ui": "3.93.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "graphql": "16.15.0",
    "next": "16.4.6",
    "payload": "3.93.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rimraf": "6.1.4",
    "sharp": "0.35.5",
    "typescript": "6.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "zod": "3.25.76"
  },
  "engines": {
    "node": "^22.23.5 || ^24.22.3 || >=26.13.1"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
